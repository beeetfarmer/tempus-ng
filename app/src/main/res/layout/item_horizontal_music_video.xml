<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/music_video_thumbnail_image_view"
        android:layout_width="132dp"
        android:layout_height="74dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/music_video_duration_label"
        style="@style/LabelSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/bg_music_video_duration"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/music_video_thumbnail_image_view"
        app:layout_constraintEnd_toEndOf="@+id/music_video_thumbnail_image_view"
        tools:text="3:47" />

    <TextView
        android:id="@+id/music_video_title_label"
        style="@style/LabelMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/music_video_subtitle_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_video_thumbnail_image_view"
        app:layout_constraintTop_toTopOf="@+id/music_video_thumbnail_image_view"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="A rather long music video title that wraps" />

    <TextView
        android:id="@+id/music_video_subtitle_label"
        style="@style/LabelSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/music_video_thumbnail_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_video_thumbnail_image_view"
        app:layout_constraintTop_toBottomOf="@+id/music_video_title_label"
        tools:text="Artist name • 2024" />

</androidx.constraintlayout.widget.ConstraintLayout>
